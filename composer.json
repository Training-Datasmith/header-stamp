{
    "name": "prestashop/header-stamp",
    "description": "Rewrite your file headers to add the license or to make them up-to-date",
    "homepage": "https://github.com/PrestaShopCorp/header-stamp",
    "license": "AFL-3.0",
    "authors": [
        {
            "name": "PrestaShop SA",
            "email": "contact@prestashop.com"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/Training-Datasmith/composer-index/remote-test-2026-11-09",
            "canonical": false
        }
    ],
    "require": {
        "php": "^8.0 || ^7.2",
        "symfony/console": "^3.4 || ~4.0 || ~5.0 || ~6.0",
        "symfony/finder": "^3.4 || ~4.0 || ~5.0 || ~6.0",
        "symfony/yaml": "^3.4 || ~4.0 || ~5.0 || ~6.0",
        "nikic/php-parser": "^4.10"
    },
    "config": {
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "optimize-autoloader": true,
        "lock": false,
        "sort-packages": true,
        "platform": {
            "php": "7.2.5"
        }
    },
    "bin": [
        "bin/header-stamp"
    ],
    "autoload": {
        "psr-4": {
            "Presta_Shop\\Header_Stamp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Integration\\": "tests/Integration",
            "Tests\\Unit\\": "tests/Unit"
        }
    },
    "author": "PrestaShop",
    "require-dev": {
        "prestashop/php-dev-tools": "^5",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^8.5.52"
    },
    "scripts": {
        "integration-tests": [
            "@php -d date.timezone=UTC -d error_reporting=32767 ./vendor/phpunit/phpunit/phpunit -c tests/Integration/phpunit.xml --colors=never"
        ],
        "unit-tests": [
            "@php -d date.timezone=UTC -d error_reporting=32767 ./vendor/phpunit/phpunit/phpunit -c tests/Unit/phpunit.xml --colors=never"
        ],
        "lint": "bash scripts/lint-src.sh",
        "pins": "@php scripts/check-cluster-pins.php",
        "rename-check": "@php scripts/check-rename.php",
        "test": [
            "@unit-tests",
            "@integration-tests",
            "@pins",
            "@rename-check",
            "@lint"
        ]
    }
}
